@RealEstate.Api_HostAddress = http://localhost:5231
@exampleEmail = developer@example.invalid
@examplePassword = Example-only-password-123!
@accessToken = paste-access-token-here

GET {{RealEstate.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{RealEstate.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "{{exampleEmail}}",
  "password": "{{examplePassword}}",
  "firstName": "Example",
  "lastName": "Developer",
  "phoneNumber": null
}

###

POST {{RealEstate.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{exampleEmail}}",
  "password": "{{examplePassword}}"
}

###

GET {{RealEstate.Api_HostAddress}}/api/listings?lang=en&page=1&pageSize=20
Accept: application/json
X-Request-ID: sample-public-listings-request

###

GET {{RealEstate.Api_HostAddress}}/api/listings/my?lang=en&page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{accessToken}}

###
